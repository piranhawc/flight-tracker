version: "3.8"
services:
  flight-tracker:
    build: .
    container_name: flight-tracker
    restart: unless-stopped
    network_mode: host
    environment:
      - PORT=3099
      - ICS_URL=https://cal.example.com/yourcalendarid.ics
      - FA_API_KEY=<Your_FlightAware_Token>
      - LOGBOOK_PASSWORD=<set-a-real-password>
      - FRIENDS_PASSWORD=<shared-password-all-friends-use>
      - APA_SABRE_BASE=http://192.168.128.115:8765
      - CREW_DB_PATH=/data/flight-tracker.db
      - AGENTMAIL_API_KEY=<your_agentmail_api_key>
      - ADMIN_NOTIFY_EMAIL=you@example.com
      # Optional: phone-position gate signal via Home Assistant
      - HA_URL=http://192.168.1.x:8123
      - HA_TOKEN=<long-lived-access-token>
      - HA_ENTITY=person.your_name
    volumes:
      - ./data:/data
